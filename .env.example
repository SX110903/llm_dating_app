# Copy to .env and provide every blank secret, or run scripts/setup-dev.ps1.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:8080

POSTGRES_DB=llmatch
POSTGRES_USER=llmatch_admin
POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=
MIGRATOR_DB_PASSWORD=
REDIS_PASSWORD=

JWT_PRIVATE_KEY_PATH=./secrets/dev/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/dev/jwt_public.pem

MATCHING_DAILY_SWIPE_LIMIT=100
MATCHING_WEIGHT_INTERESTS=0.35
MATCHING_WEIGHT_QUESTIONNAIRE=0.30
MATCHING_WEIGHT_DISTANCE=0.20
MATCHING_WEIGHT_ACTIVITY=0.15

# Required only with docker-compose.prod.yml. Use managed TLS endpoints and real
# certificate files; never copy development values into production.
PRODUCTION_DATABASE_URL=
PRODUCTION_REDIS_URL=
PRODUCTION_CORS_ALLOWED_ORIGINS=
# AWS credentials come from the deployment environment's own credential
# chain (e.g. an IAM role), not from this file.
PRODUCTION_PHOTO_STORAGE_S3_BUCKET=
PRODUCTION_PHOTO_STORAGE_S3_REGION=
TLS_CERTIFICATE_PATH=
TLS_PRIVATE_KEY_PATH=
